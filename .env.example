# ============================================
# 🔐 متغيرات البيئة (Environment Variables)
# ============================================
# انسخ هذا الملف إلى .env واملأ القيم الفعلية

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Email Service (SendGrid, Mailgun, etc.)
# VITE_EMAIL_SERVICE=sendgrid
# VITE_EMAIL_API_KEY=your-email-api-key

# Optional: Payment Gateway (Stripe)
# VITE_STRIPE_PUBLIC_KEY=your-stripe-public-key

# Optional: Storage (Cloudinary)
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_API_KEY=your-api-key

# Optional: Analytics
# VITE_GOOGLE_ANALYTICS_ID=your-ga-id

# Optional: Maps
# VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key

# ============================================
# 📝 ملاحظات مهمة
# ============================================

# 1. لا ترفع ملف .env إلى Git
# 2. استخدم .env.example كقالب
# 3. القيم الحساسة يجب أن تكون في .env فقط
# 4. لإعادة التطبيق للعمل:
#    - انسخ .env.example إلى .env
#    - املأ القيم الفعلية من Supabase Dashboard
#    - أعد تشغيل التطبيق

# ============================================
# 🔧 كيفية الحصول على القيم
# ============================================

# Supabase:
# 1. اذهب إلى https://supabase.com
# 2. أنشئ مشروع جديد أو استخدم مشروع موجود
# 3. اذهب إلى Settings > API
# 4. انسخ Project URL و anon/public key

# Stripe (اختياري):
# 1. اذهب إلى https://stripe.com
# 2. انشئ حساب
# 3. اذهب إلى Developers > API keys
# 4. انسخ Publishable key

# Cloudinary (اختياري):
# 1. اذهب إلى https://cloudinary.com
# 2. انشئ حساب
# 3. انسخ Cloud Name و API Key من Dashboard
